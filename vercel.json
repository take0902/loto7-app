{
  "version": 2,
  "builds": [
    {
      "src": "api-latest.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "loto7_latest_backup.json",
      "use": "@vercel/static"
    },
    {
      "src": "loto7.json",
      "use": "@vercel/static"
    },
    {
      "src": "service-worker.js",
      "use": "@vercel/static"
    },
    {
      "src": "README.md",
      "use": "@vercel/static"
    },
    {
      "src": "loto6_latest_backup.json",
      "use": "@vercel/static"
    },
    {
      "src": "TEST_REPORT.txt",
      "use": "@vercel/static"
    },
    {
      "src": "package.json",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "app.css",
      "use": "@vercel/static"
    },
    {
      "src": "latest.json",
      "use": "@vercel/static"
    },
    {
      "src": "loto6.json",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "icon.svg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/latest",
      "dest": "/api-latest.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}