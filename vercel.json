{
  "version": 2,
  "builds": [
    {
      "src": "api-latest.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "loto6.json",
      "use": "@vercel/static"
    },
    {
      "src": "loto7.json",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "service-worker.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/latest",
      "dest": "/api-latest.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}